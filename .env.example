# Copy this file to .env and adjust values as needed for local development.
# No real secrets belong in this repository.

# --- PostgreSQL ---
POSTGRES_DB=launchpad
POSTGRES_USER=launchpad
POSTGRES_PASSWORD=launchpad
POSTGRES_PORT=5432

# --- API (FastAPI) ---
# Used by the api service. Host "db" refers to the postgres service name on
# the Docker network; this does not resolve outside of Docker Compose.
DATABASE_URL=postgresql+asyncpg://launchpad:launchpad@db:5432/launchpad
API_PORT=8000

# --- Auth (JWT access tokens) ---
# This default is fine for local development only. Generate a real secret
# for any shared/deployed environment, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Resume storage (local disk; see app/services/resume_storage.py) ---
RESUME_STORAGE_DIR=/app/storage/resumes
RESUME_MAX_SIZE_MB=5

# --- Email verification (registration OTP; see app/services/registration.py) ---
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PENDING_REGISTRATION_TOKEN_EXPIRE_MINUTES=15

# --- Email delivery (see app/services/email.py) ---
# "console" (default) logs the email instead of sending it -- fine for
# local development and required for tests. Never commit real
# credentials here -- this file only documents variable names.
#
# Development/staging: EMAIL_PROVIDER=mailtrap, with SMTP_* set to your
# Mailtrap sandbox inbox's SMTP credentials (Mailtrap testing inboxes
# issue a host/port/username/password, not an API token -- that's why
# this reuses the generic SMTP client instead of Mailtrap's API SDK).
# Typical sandbox host: sandbox.smtp.mailtrap.io, port 2525 or 587.
#
# Production (future): EMAIL_PROVIDER=resend. Not implemented yet --
# app/services/email.py's EmailService abstraction is what a Resend
# provider would plug into without touching OTP/registration logic.
EMAIL_PROVIDER=console
EMAIL_FROM=Launchpad <no-reply@launchpad.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Web (Next.js) ---
WEB_PORT=3000
# Base URL the browser uses to reach the API. localhost works because the
# api service's port is published to the host via API_PORT.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Base URL the Next.js *server* uses to reach the API over the Docker
# network. Set in docker-compose.yml to the "api" service name; override
# here only for running the web app outside Docker.
API_INTERNAL_URL=http://localhost:8000
